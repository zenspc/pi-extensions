{
	"name": "@zenspc/pi-autopilot",
	"version": "0.1.0",
	"description": "Autonomous Supervisor-Worker orchestration with persistent task DAGs and isolated Git worktrees",
	"type": "module",
	"license": "MIT",
	"author": "dhairyaar",
	"keywords": [
		"pi-package",
		"pi-extension",
		"autopilot",
		"subagents"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zenspc/pi-extensions.git",
		"directory": "packages/pi-autopilot"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/",
		"!src/**/*.test.ts",
		"!src/test-support.ts",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "26.1.1",
		"typescript": "5.9.3",
		"typebox": "1.1.38"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --experimental-strip-types --test src/*.test.ts",
		"prepack": "cp --remove-destination ../../LICENSE LICENSE",
		"postpack": "ln -sfn ../../LICENSE LICENSE"
	},
	"engines": {
		"node": ">=22.19"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
