{
  "name": "@zenspc/pi-btw",
  "version": "0.0.0",
  "description": "Tool-free /btw and /side conversations in an inline bottom panel with temporary history",
  "type": "module",
  "license": "MIT",
  "author": "dhairyaar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenspc/pi-extensions.git",
    "directory": "packages/pi-btw"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "discussion",
    "sessions"
  ],
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "26.1.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "prepack": "cp --remove-destination ../../LICENSE LICENSE",
    "postpack": "ln -sfn ../../LICENSE LICENSE"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
